{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Live: Start stack",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/live_stack.py", "--no-webrtc"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": "test",
      "problemMatcher": {
        "owner": "live-stack",
        "pattern": { "regexp": "^live stack failed: (.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^starting the server",
          "endsPattern": "^LIVE-STACK-READY"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "Boots the real server + a real engine (signalling relay forced, as the Dart and Code clients have no WebRTC) on random loopback ports and writes build/live-stack/stack.json (ready when LIVE-STACK-READY is printed). Reuses a stack that is already running. Needs ../subconscious-server/.venv."
    },
    {
      "label": "Live: Stop stack",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/live_stack.py", "--stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Stops the live stack started by 'Live: Start stack' and removes build/live-stack/stack.json."
    },
    {
      "label": "Test: Live (Python)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "tests/live", "-m", "live", "-p", "no:cacheprovider"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": [],
      "detail": "End-to-end tests against the real server and real engines (starts its own hermetic stack; about 6-8 minutes)."
    },
    {
      "label": "Test: Live (Dart core)",
      "type": "shell",
      "command": "flutter",
      "args": ["test", "--tags", "live"],
      "options": {
        "cwd": "${workspaceFolder}/apps/core_business_logic",
        "env": { "SC_LIVE_STACK": "${workspaceFolder}/build/live-stack/stack.json" }
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "apps/core_business_logic live tests against a running stack (start it with 'Live: Start stack')."
    },
    {
      "label": "Test: Live (Dart app)",
      "type": "shell",
      "command": "flutter",
      "args": ["test", "--tags", "live"],
      "options": {
        "cwd": "${workspaceFolder}/apps/unified_app",
        "env": { "SC_LIVE_STACK": "${workspaceFolder}/build/live-stack/stack.json" }
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "apps/unified_app live tests against a running stack (start it with 'Live: Start stack')."
    },
    {
      "label": "Test: Live (Dart)",
      "type": "shell",
      "command": "echo Dart live tests finished",
      "dependsOn": [
        "Live: Start stack",
        "Test: Live (Dart core)",
        "Test: Live (Dart app)"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": [],
      "detail": "Starts the live stack, then runs `flutter test --tags live` in core_business_logic and unified_app. If a stack is already running, run the two 'Test: Live (Dart ...)' tasks directly. Stop the stack with 'Live: Stop stack'."
    },
    {
      "label": "Test: Live (Code)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:live"],
      "options": {
        "cwd": "${workspaceFolder}/../subconscious-code",
        "env": { "SC_LIVE_STACK": "${workspaceFolder}/build/live-stack/stack.json" }
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "subconscious-code (VS Code extension) live tests against a running stack (start it with 'Live: Start stack')."
    },
    {
      "label": "Test: Live (all)",
      "type": "shell",
      "command": "echo all live tests finished",
      "dependsOn": [
        "Live: Start stack",
        "Test: Live (Dart core)",
        "Test: Live (Dart app)",
        "Test: Live (Code)",
        "Test: Live (Python)",
        "Live: Stop stack"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": [],
      "detail": "Starts the stack, runs the Dart, VS Code extension and Python live tests, then stops the stack. If a step fails the stack is left running: use 'Live: Stop stack'."
    },    {
      "label": "Extension: Build (Dev)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/build_extension.ps1", "-Dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Builds the Flutter web app into apps/chromium_extension/app (dev engine/server) and generates popup.html/sidepanel.html."
    },
    {
      "label": "Extension: Build (Production)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/build_extension.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Production server URL build of the extension."
    },
    {
      "label": "Flutter: Start Android Emulator",
      "type": "shell",
      "command": "flutter",
      "args": [
        "emulators",
        "--launch",
        "${input:androidEmulator}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Flutter: Build Standalone Android APK",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--release",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=https://api.subconscious.chat",
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/unified_app"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Builds build/app/outputs/flutter-apk/app-release.apk against the production server (https://api.subconscious.chat), no dev engine or token.",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Flutter: Build Android App Bundle (AAB)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "appbundle",
        "--release",
        "--build-name=${input:androidVersionName}",
        "--build-number=${input:androidVersionCode}",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=https://api.subconscious.chat",
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/unified_app"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Builds build/app/outputs/bundle/release/app-release.aab for Play Console. Prompts for version name and version code.",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Package: Engine (PyInstaller)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m", "PyInstaller",
        "packaging/engine/subconscious.spec",
        "--noconfirm",
        "--distpath", "build/packaging/pyinstaller",
        "--workpath", "build/packaging/pyinstaller-work"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Outputs build/packaging/pyinstaller/engine (subconscious.exe + subconscious-desktop.exe)."
    },
    {
      "label": "Package: Flutter Windows GUI",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "windows", "--release"],
      "options": { "cwd": "${workspaceFolder}/apps/unified_app" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Outputs apps/unified_app/build/windows/x64/runner/Release."
    },
    {
      "label": "Package: TUI (Dart exe)",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force build/packaging/tui | Out-Null; dart compile exe apps/tui_app/bin/main.dart -o build/packaging/tui/subconscious-tui.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Outputs build/packaging/tui/subconscious-tui.exe."
    },
    {
      "label": "Package: Build components",
      "type": "shell",
      "command": "echo components built",
      "dependsOn": [
        "Package: Engine (PyInstaller)",
        "Package: Flutter Windows GUI",
        // "Package: TUI (Dart exe)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Engine + GUI + TUI builds consumed by the MSIX tasks."
    },
    {
      "label": "Package: Build components (no TUI)",
      "type": "shell",
      "command": "echo components built",
      "dependsOn": [
        "Package: Engine (PyInstaller)",
        "Package: Flutter Windows GUI"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Engine + GUI only; skips the TUI."
    },
    {
      "label": "Package: MSIX (Local, self-signed, no TUI)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "packaging/msix/build_msix.ps1",
        "-Python", "${command:python.interpreterPath}",
        "-CertPath", "build/packaging/dev-cert/dev.pfx",
        "-IdentityName", "Ancilla.Subconscious.Dev",
        "-Publisher", "CN=Placeholder",
        "-CertPassword", "subconscious-dev",
        "-SkipTui"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": [
        "Package: Dev signing cert (create + trust)",
        "Package: Build components (no TUI)"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "detail": "Like the Local task but without the TUI (faster)."
    },
    {
      "label": "Package: MSIX (Store, unsigned, no TUI)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "packaging/msix/build_msix.ps1",
        "-Python", "${command:python.interpreterPath}",
        "-Version", "${input:msixVersion}",
        "-SkipTui"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Package: Build components (no TUI)"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "detail": "Like the Store task but without the TUI (faster)."
    },
    {
      "label": "Package: Dev signing cert (create + trust)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "tools/new_dev_cert.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Creates build/packaging/dev-cert/dev.pfx (CN=Placeholder) if missing and trusts it (UAC prompt). Local installs only."
    },
    {
      "label": "Package: MSIX (Local, self-signed)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "packaging/msix/build_msix.ps1",
        "-Python", "${command:python.interpreterPath}",
        "-CertPath", "build/packaging/dev-cert/dev.pfx",
        "-IdentityName", "Ancilla.Subconscious.Dev",
        "-Publisher", "CN=Placeholder",
        "-CertPassword", "subconscious-dev"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": [
        "Package: Dev signing cert (create + trust)",
        "Package: Build components"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "detail": "Signed with the dev cert; install with: Add-AppxPackage build/packaging/Subconscious-<version>.msix"
    },
    {
      "label": "Package: MSIX (Store, unsigned)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "packaging/msix/build_msix.ps1",
        "-Python", "${command:python.interpreterPath}",
        "-Version", "${input:msixVersion}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Package: Build components"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "detail": "Unsigned package for Partner Center upload (Microsoft signs on ingestion). Identity values come from the build_msix.ps1 defaults (Partner Center)."
    }
  ],
  "inputs": [
    {
      "id": "msixVersion",
      "type": "promptString",
      "description": "MSIX version (4 parts; Store requires last part 0)",
      "default": "0.1.0.0"
    },
    {
      "id": "androidVersionName",
      "type": "promptString",
      "description": "Android version name (e.g. 0.1.0)",
      "default": "0.1.0"
    },
    {
      "id": "androidVersionCode",
      "type": "promptString",
      "description": "Android version code (integer; must increase on every Play upload)",
      "default": "1"
    },
    {
      "id": "androidEmulator",
      "type": "pickString",
      "description": "Select the Android emulator to start",
      "options": [
        "Medium_Phone_API_35",
      ],
      "default": "Medium_Phone_API_35"
    }
  ]
}
