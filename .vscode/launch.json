{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Engine (Dev, LAN)",
      "type": "debugpy",
      "request": "launch",
      "module": "subconscious_engine",
      "cwd": "${workspaceFolder}/engine",
      "python": "${command:python.interpreterPath}",
      "args": [
        "start",
        "--dev",
        "--lan",
        "--port",
        "50505"
      ],
      "env": {
        "SUBCONSCIOUS_SERVER_URL": "http://127.0.0.1:5050/",
        "PYTHONPATH": "${workspaceFolder}/engine/src"
      },
      "justMyCode": true,
      "console": "internalConsole"
    },
    {
      "name": "Unified Flutter App (Connected)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "${input:flutterDevice}",
      "toolArgs": [
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=50505",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=https://api.subconscious.chat/",
        // "--dart-define=SUBCONSCIOUS_SERVER_URL=http://127.0.0.1:5050/",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token",
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "Unified Flutter App (Web, fixed port)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=8550",
        "--web-hostname=localhost",
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=50505",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=http://127.0.0.1:5050/",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token",
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "Unified Flutter App (Android Emulator)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "emulator-5554",
      "toolArgs": [
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=50505",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token"
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "TUI App (Connected)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/tui_app/bin/main.dart",
      "cwd": "${workspaceFolder}",
      "toolArgs": [
        "--define=SUBCONSCIOUS_ENGINE_URL=http://127.0.0.1:50505",
        "--define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token"
      ],
      "console": "terminal"
    }
  ],
  "inputs": [
    {
      "id": "flutterDevice",
      "type": "pickString",
      "description": "Select a Flutter target: Windows, Android emulator, Chrome, or Edge",
      "options": [
        "edge",
        "chrome",
        "windows",
        "emulator-5554",
      ],
      "default": "windows"
    }
  ]
}
