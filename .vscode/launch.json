{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Live: Stack (debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/live_stack.py",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}",
      "args": ["--engines", "1", "--no-webrtc"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: Live (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}",
      "args": ["tests/live", "-m", "live", "-p", "no:cacheprovider", "-x", "-s"],
      "env": {
        "SC_LIVE": "1",
        "PYTHONPATH": "${workspaceFolder}/engine/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Engine (Dev, LAN)",
      "type": "debugpy",
      "request": "launch",
      "module": "subconscious_engine",
      "cwd": "${workspaceFolder}/engine",
      "python": "${command:python.interpreterPath}",
      "args": [
        "start",
        "--dev",
        "--lan",
        "--port",
        "51515"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/engine/src",
        "SUBCONSCIOUS_SERVER_URL": "http://127.0.0.1:5050/",
        // "SUBCONSCIOUS_SERVER_URL" :"https://api.subconscious.chat/",
        "SUBCONSCIOUS_FERNET_KEY": "IqweDE7oO7LVqmt-4m6JT2tFPyFcMk_qjpSokXmlUnY=",
      },
      "justMyCode": true,
      // "console": "internalConsole"
    },
    {
      "name": "GUI",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "${input:flutterDevice}",
      "toolArgs": [
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=51515",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=http://127.0.0.1:5050/",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token",
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "GUI (Web)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=8550",
        "--web-hostname=localhost",
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=51515",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_SERVER_URL=http://127.0.0.1:5050/",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token",
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "GUI (Android)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/unified_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/unified_app",
      "deviceId": "emulator-5554",
      "toolArgs": [
        "--dart-define=SUBCONSCIOUS_ENGINE_DEV=true",
        "--dart-define=SUBCONSCIOUS_ENGINE_PORT=51515",
        "--dart-define=SUBCONSCIOUS_WORKSPACE_UUID=default",
        "--dart-define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token"
      ],
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "UI Kit Gallery",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/ui_gallery/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/ui_gallery",
      "deviceId": "windows",
      "flutterMode": "debug",
      "console": "terminal"
    },
    {
      "name": "Chromium Extension (Chrome)",
      "preLaunchTask": "Extension: Build (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5050/",
      "userDataDir": "${workspaceFolder}/.dart_tool/chromium-extension-profile",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/apps/chromium_extension",
        "--disable-extensions-except=${workspaceFolder}/apps/chromium_extension",
        "--no-first-run"
      ],
      "webRoot": "${workspaceFolder}/apps/chromium_extension"
    },
    {
      "name": "Chromium Extension (Edge)",
      "preLaunchTask": "Extension: Build (Dev)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5050/",
      "userDataDir": "${workspaceFolder}/.dart_tool/edge-extension-profile",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/apps/chromium_extension",
        "--disable-extensions-except=${workspaceFolder}/apps/chromium_extension",
        "--no-first-run"
      ],
      "webRoot": "${workspaceFolder}/apps/chromium_extension"
    },
    {
      "name": "TUI App (Connected)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/tui_app/bin/main.dart",
      "cwd": "${workspaceFolder}",
      "toolArgs": [
        "--define=SUBCONSCIOUS_ENGINE_URL=http://127.0.0.1:51515",
        "--define=SUBCONSCIOUS_ENGINE_TOKEN=subconscious-dev-token"
      ],
      "console": "terminal"
    }
  ],
  "inputs": [
    {
      "id": "flutterDevice",
      "type": "pickString",
      "description": "Select a Flutter target: Windows, Android emulator, Chrome, or Edge",
      "options": [
        "edge",
        "chrome",
        "windows",
        "emulator-5554",
      ],
      "default": "windows"
    }
  ]
}
