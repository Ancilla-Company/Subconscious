<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <!-- Name / Publisher / PublisherDisplayName must match Partner Center
       (Product management > Product identity). -->
  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Subconscious</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>

    <!-- Start menu: desktop GUI -->
    <Application Id="Gui" Executable="gui\gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Subconscious" Description="Subconscious desktop app"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>

    <!-- Start menu: engine with system tray icon (no console window) -->
    <Application Id="Engine" Executable="engine\{{ENGINE_TRAY_EXE}}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Subconscious Engine" Description="Subconscious engine (system tray)"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>

    <!-- Terminal only: `subconscious` command (hidden from Start menu) -->
    <Application Id="EngineCli" Executable="engine\{{ENGINE_CLI_EXE}}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Subconscious CLI" Description="Subconscious command line"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="engine\{{ENGINE_CLI_EXE}}" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="subconscious.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <!-- Terminal only: `subconscious-tui` command (hidden from Start menu) -->
    <Application Id="Tui" Executable="tui\tui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Subconscious TUI" Description="Subconscious terminal UI"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="tui\tui.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="subconscious-tui.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
